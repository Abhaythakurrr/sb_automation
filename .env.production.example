# ─────────────────────────────────────────────────────────────────────────────
# Stonebranch Automation Platform — Production Environment Variables
# Copy this to .env on the server and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stonebranch UAC ───────────────────────────────────────────────────────────
# Production UAC base URL
BASE_URL=https://adient.stonebranch.cloud

# Service account API token (generated from UAC → Administration → API Tokens)
# This is the fallback token used by the monitoring service auto-restore.
# All user sessions use their own token entered at login.
AUTH_TOKEN=

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
NODE_ENV=production
UPLOAD_DIR=/tmp/sb-uploads
MAX_FILE_SIZE=10485760

# ── Frontend ──────────────────────────────────────────────────────────────────
# Must point to the internal domain — NOT localhost in production
NEXT_PUBLIC_API_BASE_URL=https://sb-automation.adient.internal

# ── MS Teams Webhook ──────────────────────────────────────────────────────────
# Backend-only — never exposed to browser
TEAMS_WEBHOOK_URL=

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt tokens stored in scheduled_jobs.json
# Must be at least 32 characters. Change this to a strong random value.
ENCRYPTION_KEY=

# ── Test environment (optional — for test server only) ───────────────────────
# TEST_BASE_URL=https://adienttst.stonebranch.cloud
