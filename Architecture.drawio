        <mxCell id="dcc1038c" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="15 Response: {success:true, taskName, taskId, triggerId?}">
