        <mxCell id="450e9296" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#445566;fontStyle=1;" value="Recovery Runtime - Restore Implementation">
          <mxGeometry x="200" y="8" width="800" height="28" />
        </mxCell>
        <mxCell id="888004c4" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#888;" value="Upload (routes/recovery.ts) → Validate (v1.0, JSON schema) → Single/Bulk Restore (stoneBranchService) → Verify → Reconcile trigger conflicts. Files: routes/recovery.ts · utils/recoveryStore.ts · utils/payloadMapper.ts · services/stoneBranchService.ts">
          <mxGeometry x="200" y="32" width="800" height="16" />
        </mxCell>
        <mxCell id="a0443b5c" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="1  User browses to JobRecoveryPage → selects .json recovery package [frontend/JobRecoveryPage.tsx]">
          <mxGeometry x="40" y="62" width="720" height="25" />
        </mxCell>
        <mxCell id="5504477d" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="2  POST /api/delete/recovery/upload (multipart) → Multer parses file [routes/recovery.ts:15]">
          <mxGeometry x="40" y="88" width="720" height="25" />
        </mxCell>
        <mxCell id="efcd8322" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="3  Server: JSON.parse(file.buffer) → validate top-level: version === '1.0' [routes/recovery.ts:28]">
          <mxGeometry x="40" y="114" width="720" height="25" />
        </mxCell>
        <mxCell id="12a9d5c8" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="4  Validate: jobs array exists &amp;&amp; Array.isArray(jobs) &amp;&amp; jobs.length &gt; 0">
          <mxGeometry x="40" y="140" width="720" height="25" />
        </mxCell>
        <mxCell id="bac1ae55" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="5  FAIL: version mismatch → 400 'Unsupported recovery package version'">
          <mxGeometry x="40" y="166" width="720" height="25" />
        </mxCell>
        <mxCell id="0898c1ec" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="6  FAIL: empty jobs array → 400 'No jobs in recovery package'">
          <mxGeometry x="40" y="192" width="720" height="25" />
        </mxCell>
        <mxCell id="2c4f77c8" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="7  Store parsed package in req.session.recoveryPackage (session-scoped Map)">
          <mxGeometry x="40" y="218" width="720" height="25" />
        </mxCell>
        <mxCell id="275cbae7" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="8  Response JSON: {jobs: N, tasks: [jobNames], version: '1.0'} → list displayed">
          <mxGeometry x="40" y="244" width="720" height="25" />
        </mxCell>
        <mxCell id="aedaad74" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="9  User selects SINGLE or ALL restore via RadioGroup component">
          <mxGeometry x="40" y="270" width="720" height="25" />
        </mxCell>
        <mxCell id="67427a0b" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="10 SINGLE: POST /api/delete/recovery/restore {jobName} [routes/recovery.ts:55]">
          <mxGeometry x="40" y="296" width="720" height="25" />
        </mxCell>
        <mxCell id="c6a1b7d4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="11 Find job in session.recoveryPackage.jobs → reconstruct payload from backup">
          <mxGeometry x="40" y="322" width="720" height="25" />
        </mxCell>
        <mxCell id="d6f01be0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="12 payloadMapper.buildTaskPayload(row.task) from stored fields [utils/payloadMapper.ts]">
