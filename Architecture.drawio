          <mxGeometry x="40" y="398" width="720" height="25" />
        </mxCell>
        <mxCell id="46fb4352" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=none;strokeColor=#445566;strokeWidth=2;dashed=1;" value="&lt;b&gt;&lt;b&gt;TEAMS NOTIFICATION ARCHITECTURE&lt;/b&gt;&lt;/b&gt;">
