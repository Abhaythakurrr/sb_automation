        <mxCell id="68b65e81" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#e1d5e7;strokeColor=#9673a6;" value="17 Iterates all jobs: createTask → (opt) createTrigger → SSE stream per job">
