        <mxCell id="62466e9a" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="6  buildTeamsAdaptiveCard(alert): constructs Adaptive Card v1.3 JSON [utils/notificationBuilder.ts]">
          <mxGeometry x="40" y="202" width="720" height="25" />
        </mxCell>
        <mxCell id="46fc697c" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#e1d5e7;strokeColor=#9673a6;" value="7  Card Header: emoji (⚠️) + title 'Agent Down: {agentName}' / 'Job Failed: {jobName}'">
