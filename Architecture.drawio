        <mxCell id="21110c95" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="2  EventSource.onopen → setConnectionStatus('connected') → green indicator">
