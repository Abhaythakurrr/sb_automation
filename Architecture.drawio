  <diagram name="5 Job Delete Runtime" id="f6a57164">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d7f68d34" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#445566;fontStyle=1;" value="Job Delete Runtime - 6-Step Deletion Workflow">
          <mxGeometry x="200" y="8" width="800" height="28" />
        </mxCell>
        <mxCell id="58f1dc8d" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#888;" value="Inspect (routes/delete.ts) → Backup (utils/recoveryStore.ts) → Force-Finish → Delete Triggers → Delete Task → Verify → Result. Files: routes/delete.ts · routes/recovery.ts · utils/recoveryStore.ts · services/stoneBranchService.ts">
          <mxGeometry x="200" y="32" width="800" height="16" />
        </mxCell>
        <mxCell id="85bc0667" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="1  User searches task name in JobDeletionPage [frontend/JobDeletionPage.tsx]">
          <mxGeometry x="40" y="62" width="720" height="22" />
        </mxCell>
        <mxCell id="3398428f" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="2  POST /api/search/search → stoneBranchService.searchTasks(q) [routes/search.ts]">
          <mxGeometry x="40" y="86" width="720" height="24" />
        </mxCell>
        <mxCell id="46a1a2e4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="3  Results displayed → select task → dependency analysis triggered">
          <mxGeometry x="40" y="110" width="720" height="22" />
        </mxCell>
        <mxCell id="1a8f0641" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="4  POST /api/delete/inspect → getTaskDependencies() + getTaskInstances() [routes/delete.ts]">
          <mxGeometry x="40" y="134" width="720" height="24" />
        </mxCell>
        <mxCell id="c790f72e" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#e1d5e7;strokeColor=#9673a6;" value="5  UAC returns: {dependents[], activeInstances[], hasDependents, canDelete}">
          <mxGeometry x="40" y="158" width="720" height="22" />
        </mxCell>
        <mxCell id="0a0bb416" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="6  Response: {hasDependents, activeInstances, canDelete} → UI shows warnings if dependents exist">
          <mxGeometry x="40" y="182" width="720" height="22" />
        </mxCell>
        <mxCell id="867ccd71" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="7  ConfirmModal: forceFinish? backupOnly? → user confirms [ConfirmModal.tsx]">
          <mxGeometry x="40" y="206" width="720" height="22" />
        </mxCell>
        <mxCell id="41958373" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="8  POST /api/delete/confirm-delete {taskName, forceFinish} → 6-step workflow starts">
          <mxGeometry x="40" y="230" width="720" height="22" />
        </mxCell>
        <mxCell id="90bfa832" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="9  STEP 1: GET /task/{name} + triggers from UAC → recoveryStore.save(backup) [utils/recoveryStore.ts]">
          <mxGeometry x="40" y="256" width="720" height="22" />
        </mxCell>
        <mxCell id="9c325d6c" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="10 Backup saved: ${DATA_DIR}/recovery/{uuid}.json  Format: {task, triggers, deletedAt, verified}">
          <mxGeometry x="40" y="280" width="720" height="22" />
        </mxCell>
        <mxCell id="db64b7b0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="11 STEP 2: if forceFinish → POST ${UAC_URL}/task/{name}/force-finish → kills running instances">
          <mxGeometry x="40" y="304" width="720" height="22" />
        </mxCell>
        <mxCell id="75d7139e" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="12 STEP 3: For each trigger → DELETE ${UAC_URL}/trigger/{id} (multiple if more than one)">
          <mxGeometry x="40" y="328" width="720" height="22" />
        </mxCell>
        <mxCell id="1a31d28f" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="13 STEP 4: DELETE ${UAC_URL}/task/{name} → core deletion (UAC removes task)">
          <mxGeometry x="40" y="352" width="720" height="22" />
        </mxCell>
        <mxCell id="e0e7ff07" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="14 STEP 5: GET ${UAC_URL}/task/{name} → expect HTTP 404 → verified deleted">
          <mxGeometry x="40" y="376" width="720" height="22" />
        </mxCell>
        <mxCell id="3b9c2894" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#fff2cc;strokeColor=#d6b656;" value="15 STEP 6: recoveryStore.update(backupId, {deletedAt:now, verified:true})">
          <mxGeometry x="40" y="400" width="720" height="22" />
        </mxCell>
        <mxCell id="df5c0e6f" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="16 Response: {success:true, backupId, verified:true} → frontend confirmation">
          <mxGeometry x="40" y="424" width="720" height="22" />
        </mxCell>
        <mxCell id="87bd37ab" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="17 Toast: 'Job deleted. Backup ID: {uuid}' → recovery instructions">
          <mxGeometry x="40" y="448" width="720" height="22" />
        </mxCell>
        <mxCell id="644df471" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="18 ON ERROR at any step: stream {type:'error', step:N, error:msg} → backup preserved">
          <mxGeometry x="40" y="472" width="720" height="22" />
        </mxCell>
        <mxCell id="4da6ad08" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=none;strokeColor=#445566;strokeWidth=2;dashed=1;" value="&lt;b&gt;&lt;b&gt;6-STEP DELETION WORKFLOW&lt;/b&gt;&lt;/b&gt;">
          <mxGeometry x="780" y="62" width="400" height="440" />
        </mxCell>
        <mxCell id="1f0d0d22" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#d5e8d4;strokeColor=#82b366;" value="1. Search &amp; Select Task">
          <mxGeometry x="800" y="87" width="360" height="30" />
        </mxCell>
        <mxCell id="492bf086" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="2. Dependency Analysis">
          <mxGeometry x="800" y="122" width="360" height="30" />
        </mxCell>
        <mxCell id="d545e7bb" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="3. User Confirmation">
          <mxGeometry x="800" y="157" width="360" height="30" />
        </mxCell>
        <mxCell id="65d3df46" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="4. STEP 1: Generate Backup">
          <mxGeometry x="800" y="192" width="360" height="30" />
        </mxCell>
        <mxCell id="938c9dd5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="5. STEP 2: Force-Finish">
          <mxGeometry x="800" y="227" width="360" height="30" />
        </mxCell>
        <mxCell id="10a12fcf" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="6. STEP 3: Delete Triggers">
