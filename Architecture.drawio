  <diagram name="9 Backend Runtime" id="65b9d4ba">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="9cb53b14" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#445566;fontStyle=1;" value="Backend Runtime - Express Middleware Chain &amp; Service Execution">
          <mxGeometry x="200" y="8" width="800" height="28" />
        </mxCell>
        <mxCell id="5a26673a" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#888;" value="HTTP Request → Middleware (Helmet→CORS→JSON→Session→Audit) → Router → Controller → Service(s) → Utility → UAC XML → Axios → Response. Files: index.ts · middleware/*.ts · routes/*.ts · services/*.ts · utils/*.ts">
          <mxGeometry x="200" y="32" width="800" height="16" />
        </mxCell>
        <mxCell id="c8fe830e" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=none;strokeColor=#445566;strokeWidth=2;dashed=1;" value="&lt;b&gt;&lt;b&gt;MIDDLEWARE CHAIN — EXACT ORDER (index.ts:18-35)&lt;/b&gt;&lt;/b&gt;">
          <mxGeometry x="30" y="60" width="500" height="480" />
        </mxCell>
        <mxCell id="4a42dccd" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="1  HTTP Request arrives on :3001 (Express server.listen)">
          <mxGeometry x="50" y="85" width="460" height="23" />
        </mxCell>
        <mxCell id="078fb189" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="2  helmet() — 15 security headers: XSS, CSP, HSTS, X-Frame-Options [middleware/security.ts]">
          <mxGeometry x="50" y="110" width="460" height="23" />
        </mxCell>
        <mxCell id="8a69d65c" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="3  cors({origin: CORS_ORIGIN, credentials: true}) — whitelist check [index.ts:20]">
          <mxGeometry x="50" y="135" width="460" height="23" />
        </mxCell>
        <mxCell id="98a334af" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="4  express.json({limit: '10mb'}) — body parsing [index.ts:22]">
