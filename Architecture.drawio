        <mxCell id="eb86d2cc" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#e1d5e7;strokeColor=#9673a6;" value="8  Card Body: message text + FactSet: severity, time, type, source">
