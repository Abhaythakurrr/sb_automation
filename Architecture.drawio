        </mxCell>
        <mxCell id="9399d953" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#e1d5e7;strokeColor=#9673a6;" value="13 stoneBranchService.createTask(payload) → POST ${UAC_URL}/task [services/stoneBranchService.ts]">
