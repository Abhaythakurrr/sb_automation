        <mxCell id="22623d2e" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="7. STEP 4: Delete Task">
          <mxGeometry x="800" y="297" width="360" height="30" />
        </mxCell>
        <mxCell id="16cf5bb8" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#f8cecc;strokeColor=#b85450;" value="8. STEP 5: Verify (expect 404)">
