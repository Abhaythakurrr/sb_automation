        <mxCell id="2a3cb774" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontColor=#000;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="2  Generates UUID v4 → session ID (36 chars)">
