# ─────────────────────────────────────────────────────────────────────────────
# Stonebranch Automation Platform — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/
.next/
**/.next/


.env
.env.*
.env.local
.env.development
.env.production
**/.env
**/.env.*
!.env.example
!**/.env.example

# Uploads — user files, not source code
uploads/
**/uploads/

# Logs — never commit
*.log
# Rotated logs are gzipped, so *.log does not match them.
*.log.gz
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
audit.log
**/audit.log

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
# LibreOffice lock files
.~lock.*

# TypeScript cache
*.tsbuildinfo
**/*.tsbuildinfo

# Shared package — not used in production
shared/

# OpenAPI spec — large reference file, not needed in repo
openapi.json

# Excel / ODS / CSV — generated or uploaded files — NEVER commit any
*.xlsx
*.ods
*.csv

# State files — contain sensitive data, never commit.
#
# These are written at runtime with a per-session suffix, e.g.
# monitor_config_<uuid>.json, so the patterns must be prefix globs. A bare
# `monitor_config.json` does NOT match the file the app actually writes — and
# those files contain a live UAC token and the Teams webhook URL.
scheduled_jobs.json
**/scheduled_jobs.json
monitor_state*.json
**/monitor_state*.json
alert_history*.json
**/alert_history*.json
monitor_config*.json
**/monitor_config*.json
monitor_sent_alerts.json
**/monitor_sent_alerts.json
# Directories the runtime state lives in.
monitor_configs/
**/monitor_configs/
monitor_states/
**/monitor_states/
monitor_history/
**/monitor_history/
creation_log.json
recovery_store.json
**/recovery_store.json
**/creation_log.json

# Scratch scripts — one-off scripts with hardcoded values
backend/create_*.js
backend/update_*.js
backend/check_*.js
backend/edit_*.py
backend/verify_*.js
backend/gen_*.js
backend/generate_*.js

# Internal docs — never push to repo
docs/
analytics_cache.json
**/analytics_cache.json

# Design theme docs — not application code
themes/
**/themes/

SELF_SERVICE/

# ─────────────────────────────────────────────────────────────────────────────
# Copilot runtime state
# ─────────────────────────────────────────────────────────────────────────────
# These are per-deployment, not source. The shipped model lives in
# backend/src/copilot/ml/weights.generated.json, which IS committed.
#
# Feedback ledger — records what real users typed.
copilot_feedback.json
**/copilot_feedback.json
# Corrections learned at runtime, plus the gradient steps they represent. A
# deployment's accumulated learning belongs to that deployment; committing it
# would push one environment's corrections onto every other.
copilot_online.json
**/copilot_online.json
