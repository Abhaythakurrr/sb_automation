# ─────────────────────────────────────────────────────────────────────────────
# Stonebranch Automation Platform — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/
.next/
**/.next/

# Environment files — NEVER commit secrets or env templates
.env
.env.*
.env.example
.env.production.example
.env.local
.env.development
.env.production
**/.env
**/.env.*

# Uploads — user files, not source code
uploads/
**/uploads/

# Logs — never commit
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
audit.log
**/audit.log

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
# LibreOffice lock files
.~lock.*

# TypeScript cache
*.tsbuildinfo
**/*.tsbuildinfo

# Shared package — not used in production
shared/

# OpenAPI spec — large reference file, not needed in repo
openapi.json

# Excel / ODS / CSV — generated or uploaded files — NEVER commit any
*.xlsx
*.ods
*.csv

# State files — contain sensitive data, never commit
scheduled_jobs.json
**/scheduled_jobs.json
monitor_state.json
**/monitor_state.json
alert_history.json
**/alert_history.json
monitor_config.json
**/monitor_config.json

# Scratch scripts — one-off scripts with hardcoded values
backend/create_*.js
backend/update_*.js
backend/check_*.js
backend/edit_*.py
backend/verify_*.js
backend/gen_*.js
backend/generate_*.js

# Internal docs — never push to repo
docs/
