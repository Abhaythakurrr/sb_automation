# Stonebranch Automation Platform — Environment Configuration
# Generated by Ansible — do not edit manually on the server.
# To change values, update Ansible vault and re-run the playbook.

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT={{ backend_port | default(3001) }}
NODE_ENV=production
UPLOAD_DIR=/tmp/sb-uploads
MAX_FILE_SIZE=10485760

# ── Frontend ──────────────────────────────────────────────────────────────────
# Points to the internal domain — NOT localhost
NEXT_PUBLIC_API_BASE_URL=https://{{ domain_name }}
NEXT_PUBLIC_ENABLE_CONSOLE_LOGGING=false

# ── Stonebranch UAC ───────────────────────────────────────────────────────────
# BASE_URL and AUTH_TOKEN are intentionally left blank.
# Users enter their own UAC base URL and bearer token via the UI.
# The platform does NOT store or preset any UAC credentials.
BASE_URL=
AUTH_TOKEN=

# ── MS Teams Webhook ──────────────────────────────────────────────────────────
# Set this in Ansible vault: ansible-vault encrypt_string '<webhook-url>' --name teams_webhook
TEAMS_WEBHOOK_URL={{ teams_webhook | default('') }}

# ── Power Automate (job documentation push) ────────────────────────────────────
# Set this in Ansible vault if the job-doc push feature is used.
POWER_AUTOMATE_URL={{ power_automate_url | default('') }}

# ── Encryption ────────────────────────────────────────────────────────────────
# Set this in Ansible vault: ansible-vault encrypt_string '<key>' --name encryption_key
# Must be at least 32 characters.
ENCRYPTION_KEY={{ encryption_key }}

# ── Security hardening ──────────────────────────────────────────────────────────
# Frontend and API are served from the same internal domain (same-origin).
CORS_ORIGINS=https://{{ domain_name }}
ALLOW_ENV_TOKEN_FALLBACK=false

# ── ServiceNow instances (incident deep-links in monitoring alerts) ─────────────
SERVICENOW_PROD_HOST={{ servicenow_prod_host | default('adientprod.service-now.com') }}
SERVICENOW_NONPROD_HOST={{ servicenow_nonprod_host | default('adientdev.service-now.com') }}

# ── Logging (centralized Winston framework) ─────────────────────────────────────
# Administrator-configurable log location — written by the app if it has permission.
LOG_DIRECTORY={{ log_directory | default(app_dir + '/logs') }}
LOG_LEVEL={{ log_level | default('info') }}
LOG_RETENTION_DAYS={{ log_retention_days | default(30) }}
LOG_MAX_FILE_SIZE={{ log_max_file_size | default('20m') }}
ENABLE_CONSOLE_LOGGING=false
