# ─────────────────────────────────────────────────────────────────────────────
# Stonebranch Automation Platform — Environment Template
#
# Copy this file to `.env` and fill in the values for your environment:
#     cp .env.example .env
#
# The backend loads `backend/.env` first and falls back to this repo-root `.env`,
# so a single top-level `.env` configures the whole application.
# Never commit a filled-in `.env` — it contains secrets. Only this template
# (with placeholder values) is tracked in version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stonebranch UAC connection (OPTIONAL fallback) ──────────────────────────
# Leave BLANK for normal multi-user operation: each user supplies their own UAC
# base URL and bearer token through the application UI, and the token is never
# persisted server-side. These are only a fallback for single-tenant setups and
# are ignored unless ALLOW_ENV_TOKEN_FALLBACK=true.
BASE_URL=
AUTH_TOKEN=

# ── Backend runtime ─────────────────────────────────────────────────────────
BACKEND_PORT=3001
NODE_ENV=production
# Directory for temporary spreadsheet uploads (files are deleted after parsing).
UPLOAD_DIR=./uploads
# Maximum upload size in bytes (default 10 MB).
MAX_FILE_SIZE=10485760

# ── Frontend (NEXT_PUBLIC_* values are exposed to the browser) ──────────────
# Base URL the browser uses to reach the backend API.
# Local dev: http://localhost:3001 — Production: https://<your-domain>
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Optional: pre-fills the Stonebranch base URL field in the UI (users can edit).
NEXT_PUBLIC_SB_BASE_URL=
# Set to "true" to allow browser console logging in a production build.
NEXT_PUBLIC_ENABLE_CONSOLE_LOGGING=false

# ── MS Teams alerts (Power Automate inbound webhook) ────────────────────────
# Used by the Monitoring feature to post agent/job-failure Adaptive Cards.
# Paste the full trigger URL from your Power Automate flow. Leave blank to
# disable Teams alerts.
TEAMS_WEBHOOK_URL=

# ── Power Automate flow (job documentation push) ────────────────────────────
# Endpoint the "push job doc" feature posts rows to. Leave blank to disable.
POWER_AUTOMATE_URL=

# ── Encryption key (data at rest) ───────────────────────────────────────────
# Encrypts scheduled-job tokens stored on disk. REQUIRED — the backend refuses
# to start without it. Must be at least 32 characters.
# Generate a strong key with:  openssl rand -base64 32
ENCRYPTION_KEY=

# ── ServiceNow instances (for incident deep-links in alerts) ────────────────
# Hosts used to build ServiceNow links from incident numbers found in job
# operational memos. Defaults shown; override per organisation.
SERVICENOW_PROD_HOST=
SERVICENOW_NONPROD_HOST=

# ── Security hardening ──────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins permitted to call the API.
# Set to your real frontend origin(s) in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Allow the server-side AUTH_TOKEN to authorise requests without a UI session.
# Leave false for multi-user deployments — "true" is an auth-bypass risk.
ALLOW_ENV_TOKEN_FALLBACK=false

# ── Logging (centralized Winston logging framework) ─────────────────────────
# Directory where log files are written. The app creates it if missing (and it
# has permission). Development: ./logs — Production example: /var/log/stonebranch-tool
LOG_DIRECTORY=./logs
# Lowest level written to the general log: fatal | error | warn | info | debug.
# Use "debug" in development, "info" in production.
LOG_LEVEL=info
# Days of rotated log files to retain before deletion.
LOG_RETENTION_DAYS=30
# Rotate a log file once it reaches this size (e.g. 20m, 100k, 1g).
LOG_MAX_FILE_SIZE=20m
# Mirror logs to stdout. Recommended false in production (logs go to files).
ENABLE_CONSOLE_LOGGING=false
