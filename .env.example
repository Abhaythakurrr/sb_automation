# Stonebranch API — set these at runtime, never commit real values
BASE_URL=
AUTH_TOKEN=

# Backend
BACKEND_PORT=3001
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend API base
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# MS Teams webhook (backend only — never expose to frontend)
TEAMS_WEBHOOK_URL=

# Encryption key for sensitive data at rest (min 32 characters)
ENCRYPTION_KEY=change-this-to-a-32-character-secret-key
